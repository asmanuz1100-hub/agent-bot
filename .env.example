# VPS production environment. Copy to .env and fill the secrets.
# bot.py does not load this file directly; docker compose injects it.

# Telegram
BOT_TOKEN=
ADMIN_IDS=
TEST_AGENT_IDS=

# Public HTTPS hostname for the VPS backend, without https://
# Example: bot.example.com
APP_DOMAIN=

# Keep this stable after first production start.
# Allowed characters: A-Z a-z 0-9 _ -
WEBHOOK_SECRET=

# PostgreSQL in docker-compose
POSTGRES_USER=asman
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=asman_agent
DB_SCHEMA=agentbot

# Existing static Mini Apps can stay on Render during the backend migration.
MANAGER_MINIAPP_URL=https://asman-manager-miniapp-test.onrender.com/
AGENT_MINIAPP_URL=https://asman-agent-miniapp-v2-test.onrender.com/?v=20260928-offline-v2

# Disable the old Agent V2 test launcher unless it is intentionally needed.
AGENT_V2_TEST_URL=

# OCR
OPENAI_API_KEY=
OCR_MODEL=gpt-4.1-mini

# Normally injected/overridden by docker-compose.yml.
PORT=10000
