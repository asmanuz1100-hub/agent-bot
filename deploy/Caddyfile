{$APP_DOMAIN} {
    encode zstd gzip

    reverse_proxy app:10000

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    log {
        output stdout
        format console
    }
}
